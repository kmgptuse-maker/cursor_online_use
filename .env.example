# Supabase (optional � app uses local file store if not set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider for learning path generation: deepseek | openai
AI_PROVIDER=deepseek

# DeepSeek (workshop default)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=30000
